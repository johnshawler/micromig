# Mini Mig Harness: provisional stock PAL A500, original OCS, 512 KiB total RAM.
[fs-uae]
amiga_model = A500
uae_chipset = ocs
cpu = 68000
chip_memory = 512
slow_memory = 0
fast_memory = 0
ntsc_mode = 0
accuracy = 1
floppy_drive_0 = ../build/mini-mig.adf
# Supply a private, lawfully obtained A500 Kickstart via the command line.
# Configuration and actual runtime values still require FS-UAE validation.
